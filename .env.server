# AION Production Server Configuration
# Single 14B model, concurrency=1, fail-closed guards

AION_DEVICE=server
AION_MODEL=qwen2.5:14b
OLLAMA_NUM_GPU=99
OLLAMA_GPU_LAYERS=999
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_MAX_QUEUE=20
OLLAMA_KEEP_ALIVE=24h
OLLAMA_FLASH_ATTENTION=1
OLLAMA_NUM_THREADS=18

AION_PORT=8100
VITE_AION_API_URL=http://127.0.0.1:8100

AION_USE_UNIFIED=true
AION_STRICT_GROUNDING=true
AION_STRICT_VALIDATION=true
AION_STRICT_RENDERING=true

AION_ALLOW_EXTERNAL_KNOWLEDGE=false
AION_ALLOW_SYNTHESIS=false
AION_ALLOW_MODEL_FALLBACK=false

AION_MIN_EXTRACTION_CONFIDENCE=0.70
AION_MIN_GROUNDING_SCORE=0.80

AION_ENABLE_VRE=true
AION_ENABLE_AUTO_HEALER=true
AION_LOG_LEVEL=INFO
