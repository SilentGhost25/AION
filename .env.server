# AION Server Configuration — L40 48GB GPU
# Load with: .\start_aion.ps1 server
# Or on Linux: source .env.server && python aion_api.py

AION_DEVICE=server
AION_MODEL=qwen2.5:14b
OLLAMA_NUM_GPU=99
OLLAMA_GPU_LAYERS=999
OLLAMA_NUM_PARALLEL=4
OLLAMA_MAX_QUEUE=20
OLLAMA_KEEP_ALIVE=24h
OLLAMA_FLASH_ATTENTION=1
OLLAMA_NUM_THREADS=18
