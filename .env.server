# AION Production Server Configuration
# Single 14B model, concurrency=2 (conservative rollout), fail-closed guards

AION_DEVICE=server
AION_MODEL=Qwen/Qwen2.5-14B-Instruct-AWQ
AION_CONCURRENCY=12
AION_GPU_UTILIZATION=0.85

# --- MinerU Cloud Precision Extraction (1,000 free pages/day, 0 MB local VRAM) ---
# When set, extraction runs on OpenDataLab cloud; if unset/offline, falls back to local engine.
# MINERU_API_KEY=

# --- vLLM High-Throughput Engine (Active Production Default) ---
AION_BACKEND=vllm
AION_LLM_HOST=http://localhost:8000
AION_SEED=42
# -------------------------------------------------------------
OLLAMA_NUM_GPU=99
OLLAMA_GPU_LAYERS=999
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_MAX_QUEUE=20
OLLAMA_KEEP_ALIVE=24h
OLLAMA_FLASH_ATTENTION=1
OLLAMA_NUM_THREADS=18

AION_PORT=8100
VITE_AION_API_URL=http://127.0.0.1:8100

AION_USE_UNIFIED=true
AION_STRICT_GROUNDING=true
AION_STRICT_VALIDATION=true
AION_STRICT_RENDERING=true

AION_ALLOW_EXTERNAL_KNOWLEDGE=false
AION_ALLOW_SYNTHESIS=false
AION_ALLOW_MODEL_FALLBACK=false

AION_MIN_EXTRACTION_CONFIDENCE=0.70
AION_MIN_GROUNDING_SCORE=0.80

AION_ENABLE_VRE=true
AION_ENABLE_AUTO_HEALER=true
AION_LOG_LEVEL=INFO

# Optimization Flags (Phase 2 & Phase 3)
ENABLE_EXTRACTION_CACHE=true
OCR_WORD_COUNT_THRESHOLD=100

# Architectural Hardening Flags (Canary Rollout — default false)
AION_ENABLE_UNRESOLVED_HARD_BLOCK=false
AION_ENABLE_BLOCK_CLASSIFIER=false
AION_ENABLE_STRUCTURED_EXTRACTION=false
AION_ENABLE_TOPIC_VALIDATOR=false
AION_ENABLE_VERB_TASK_LINTER=false
AION_FAITHFULNESS_THRESHOLD=0.75
AION_QA_THRESHOLD=75.0
