#!/bin/bash
# =============================================================
# AIQ — Academic Intelligence Questioning
# Linux / Ubuntu Server Launcher
# Usage:
#   ./aiq              → start everything (dynamic port allocation)
#   ./aiq [port]       → start everything with preferred backend port
#   ./aiq backend [p]  → backend only
#   ./aiq frontend [p] → frontend only
#   ./aiq status       → check running services
#   ./aiq stop         → stop all AIQ processes safely
#   ./aiq logs         → tail backend logs
#   ./aiq model        → show resolved model
#   ./aiq install      → install global 'aiq' command
# =============================================================

set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
LOG_DIR="$ROOT/logs"
BACKEND_LOG="$LOG_DIR/backend.log"
PID_DIR="$ROOT/.aiq"
BACKEND_PID_FILE="$PID_DIR/backend.pid"
FRONTEND_PID_FILE="$PID_DIR/frontend.pid"
PORTS_FILE="$PID_DIR/ports.env"

DEFAULT_BACKEND_PORT=8100
DEFAULT_FRONTEND_PORT=5174
FRONTEND_DIR="$ROOT/frontend/artifacts/qp-generator"

PORT_OVERRIDE=""

# ── Colours ───────────────────────────────────────────────────────────────────
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

# ── Helpers ───────────────────────────────────────────────────────────────────

banner() {
    echo -e "${CYAN}"
    echo "  ╔═══════════════════════════════════════╗"
    echo "  ║          AIQ — Academic IQ             ║"
    echo "  ║   Academic Intelligence Questioning    ║"
    echo "  ╚═══════════════════════════════════════╝"
    echo -e "${NC}"
}

log()    { echo -e "${GREEN}[AIQ]${NC} $*"; }
warn()   { echo -e "${YELLOW}[AIQ]${NC} $*"; }
error()  { echo -e "${RED}[AIQ ERROR]${NC} $*" >&2; }
header() { echo -e "\n${BOLD}$*${NC}"; }

require() {
    command -v "$1" >/dev/null 2>&1 || {
        error "Required command not found: $1"
        exit 1
    }
}

ensure_dirs() {
    mkdir -p "$LOG_DIR" "$PID_DIR"
}

activate_venv() {
    if [[ -n "${VIRTUAL_ENV:-}" ]]; then
        log "Using currently active virtual environment: $VIRTUAL_ENV"
    elif [[ -f "$ROOT/.venv/bin/activate" ]]; then
        source "$ROOT/.venv/bin/activate"
        log "Virtual environment activated (.venv/)"
    elif [[ -f "$ROOT/venv/bin/activate" ]]; then
        source "$ROOT/venv/bin/activate"
        log "Virtual environment activated (venv/)"
    else
        warn "No virtual environment found — using system Python"
    fi
}

resolve_model() {
    python -c "
from core.config.production_model import get_production_model, get_resolution_info
m = get_production_model()
i = get_resolution_info()
print(f\"{m} (source: {i['source']}, device: {i['device']})\")
" 2>/dev/null || echo "qwen2.5:14b (config default)"
}

is_port_open() {
    local port="$1"
    if command -v nc >/dev/null 2>&1; then
        nc -z 127.0.0.1 "$port" 2>/dev/null
    elif command -v lsof >/dev/null 2>&1; then
        lsof -i:"$port" >/dev/null 2>&1
    else
        (echo > "/dev/tcp/127.0.0.1/$port") 2>/dev/null
    fi
}

read_pid() {
    local f="$1"
    [[ -f "$f" ]] && cat "$f" || echo ""
}

is_running() {
    local pid="$1"
    [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null
}

write_pid() {
    echo "$1" > "$2"
}

read_ports() {
    if [[ -f "$PORTS_FILE" ]]; then
        while IFS='=' read -r key val || [[ -n "$key" ]]; do
            [[ -z "$key" || "$key" =~ ^# ]] && continue
            export "$key"="$val"
        done < "$PORTS_FILE"
    fi
    BACKEND_PORT="${AION_PORT:-${BACKEND_PORT:-$DEFAULT_BACKEND_PORT}}"
    FRONTEND_PORT="${FRONTEND_PORT:-$DEFAULT_FRONTEND_PORT}"
}

allocate_ports() {
    local desired_backend="${PORT_OVERRIDE:-${AION_PORT:-${BACKEND_PORT:-$DEFAULT_BACKEND_PORT}}}"
    local desired_frontend="${FRONTEND_PORT_OVERRIDE:-${FRONTEND_PORT:-$DEFAULT_FRONTEND_PORT}}"

    local resolved_backend
    resolved_backend=$(python -c "from core.config.server_config import find_available_port; print(find_available_port($desired_backend))" 2>/dev/null || echo "$desired_backend")
    if [[ "$resolved_backend" != "$desired_backend" ]]; then
        warn "Port $desired_backend is occupied. Dynamically selected port: $resolved_backend"
    fi
    BACKEND_PORT="$resolved_backend"
    export AION_PORT="$resolved_backend"
    export BACKEND_PORT="$resolved_backend"

    local resolved_frontend
    resolved_frontend=$(python -c "from core.config.server_config import find_available_port; print(find_available_port($desired_frontend))" 2>/dev/null || echo "$desired_frontend")
    if [[ "$resolved_frontend" != "$desired_frontend" ]]; then
        warn "Port $desired_frontend is occupied. Dynamically selected port: $resolved_frontend"
    fi
    FRONTEND_PORT="$resolved_frontend"
    export FRONTEND_PORT="$resolved_frontend"

    mkdir -p "$PID_DIR"
    cat <<EOF > "$PORTS_FILE"
BACKEND_PORT=$BACKEND_PORT
AION_PORT=$AION_PORT
FRONTEND_PORT=$FRONTEND_PORT
EOF
}

cleanup() {
    echo ""
    warn "Shutting down AIQ..."
    cmd_stop
    exit 0
}

# ── Commands ──────────────────────────────────────────────────────────────────

cmd_backend() {
    header "Starting AIQ Backend"
    ensure_dirs
    cd "$ROOT"
    activate_venv
    allocate_ports

    # Only stop prior instance if recorded by this launcher
    local old_pid
    old_pid=$(read_pid "$BACKEND_PID_FILE")
    if is_running "$old_pid"; then
        warn "Stopping previous AIQ backend instance (PID $old_pid)..."
        kill "$old_pid" 2>/dev/null || true
        sleep 1
    fi

    local model
    model=$(resolve_model)
    log "Resolved model: $model"
    log "Backend log: $BACKEND_LOG"
    log "Starting on port $BACKEND_PORT..."

    python aion_api.py >> "$BACKEND_LOG" 2>&1 &
    local pid=$!
    write_pid "$pid" "$BACKEND_PID_FILE"
    log "Backend PID: $pid"

    # Wait for backend to become ready
    local retries=0
    while ! is_port_open "$BACKEND_PORT"; do
        if ! is_running "$pid"; then
            echo ""
            error "Backend process (PID $pid) exited prematurely!"
            error "--- Last 20 lines of $BACKEND_LOG ---"
            tail -n 20 "$BACKEND_LOG"
            return 1
        fi
        sleep 1
        retries=$((retries + 1))
        if [[ $retries -ge 30 ]]; then
            error "Backend did not start within 30 seconds"
            error "Check logs: $BACKEND_LOG"
            return 1
        fi
        echo -n "."
    done
    echo ""
    log "Backend ready at http://localhost:$BACKEND_PORT"
}

cmd_frontend() {
    header "Starting AIQ Frontend"
    ensure_dirs
    read_ports

    if [[ ! -d "$FRONTEND_DIR" ]]; then
        error "Frontend directory not found: $FRONTEND_DIR"
        return 1
    fi

    local old_pid
    old_pid=$(read_pid "$FRONTEND_PID_FILE")
    if is_running "$old_pid"; then
        warn "Stopping previous AIQ frontend instance (PID $old_pid)..."
        kill "$old_pid" 2>/dev/null || true
        sleep 1
    fi

    cd "$FRONTEND_DIR"
    require pnpm

    export BACKEND_PORT="$BACKEND_PORT"
    export AION_PORT="$BACKEND_PORT"
    export FRONTEND_PORT="$FRONTEND_PORT"

    pnpm run dev --host --port "$FRONTEND_PORT" &
    local pid=$!
    write_pid "$pid" "$FRONTEND_PID_FILE"
    log "Frontend PID: $pid"
    log "Frontend starting on port $FRONTEND_PORT (mapping backend $BACKEND_PORT)..."

    # Wait for Vite to initialize
    sleep 3
    log "Frontend ready — accessible at http://0.0.0.0:$FRONTEND_PORT"
}

cmd_start() {
    banner

    header "System Check"
    require python
    require pnpm

    # Load environment
    local device="${AION_DEVICE:-}"
    if [[ -z "$device" ]]; then
        # Auto-detect from available RAM
        local free_gb
        free_gb=$(free -g 2>/dev/null | awk '/^Mem:/{print $7}' || echo "16")
        if   [[ "$free_gb" -ge 30 ]]; then device="server"
        elif [[ "$free_gb" -ge 10 ]]; then device="desktop"
        else                               device="laptop"
        fi
        log "Auto-detected device: $device (${free_gb}GB free RAM)"
        export AION_DEVICE="$device"
    fi

    # Load .env file if present
    local envfile="$ROOT/.env.$device"
    if [[ -f "$envfile" ]]; then
        set -a
        source "$envfile"
        set +a
        log "Loaded: .env.$device"
    fi

    trap cleanup EXIT INT TERM

    cmd_backend
    cmd_frontend

    echo ""
    echo -e "${GREEN}${BOLD}================================================${NC}"
    echo -e "${GREEN}${BOLD}  AIQ is running${NC}"
    echo -e "${GREEN}  Backend  : http://localhost:$BACKEND_PORT${NC}"
    echo -e "${GREEN}  Frontend : http://0.0.0.0:$FRONTEND_PORT${NC}"
    echo -e "${GREEN}  Device   : $device${NC}"
    echo -e "${GREEN}  Logs     : $BACKEND_LOG${NC}"
    echo -e "${GREEN}${BOLD}================================================${NC}"
    echo ""
    log "Press Ctrl+C to stop all services"

    # Keep alive — wait for all background jobs
    wait
}

cmd_stop() {
    header "Stopping AIQ"
    read_ports

    local backend_pid frontend_pid
    backend_pid=$(read_pid "$BACKEND_PID_FILE")
    frontend_pid=$(read_pid "$FRONTEND_PID_FILE")

    # Safely verify process name before terminating
    if is_running "$backend_pid"; then
        local comm
        comm=$(ps -p "$backend_pid" -o comm= 2>/dev/null || echo "")
        if [[ "$comm" =~ python ]]; then
            kill "$backend_pid" 2>/dev/null || true
            log "Backend stopped (PID $backend_pid)"
        else
            warn "PID $backend_pid is '$comm' (not Python) — skipping kill to protect other processes."
        fi
    fi

    if is_running "$frontend_pid"; then
        local comm
        comm=$(ps -p "$frontend_pid" -o comm= 2>/dev/null || echo "")
        if [[ "$comm" =~ node|pnpm ]]; then
            kill "$frontend_pid" 2>/dev/null || true
            log "Frontend stopped (PID $frontend_pid)"
        else
            warn "PID $frontend_pid is '$comm' (not Node) — skipping kill to protect other processes."
        fi
    fi

    rm -f "$BACKEND_PID_FILE" "$FRONTEND_PID_FILE" "$PORTS_FILE"
    log "AIQ stopped."
}

cmd_status() {
    header "AIQ Status"
    read_ports

    local backend_pid frontend_pid
    backend_pid=$(read_pid "$BACKEND_PID_FILE")
    frontend_pid=$(read_pid "$FRONTEND_PID_FILE")

    # Backend
    if is_port_open "$BACKEND_PORT"; then
        echo -e "  Backend   ${GREEN}● running${NC}  (port $BACKEND_PORT, PID ${backend_pid:-active})"
        # Try health check
        local health
        health=$(curl -sf "http://localhost:$BACKEND_PORT/api/health" 2>/dev/null || curl -sf "http://localhost:$BACKEND_PORT/api/v1/health" 2>/dev/null || echo "{}")
        local model status
        model=$(echo "$health" | python -c "import sys,json; d=json.load(sys.stdin); print(d.get('resolved_model', d.get('model', '?')))" 2>/dev/null || echo "?")
        status=$(echo "$health" | python -c "import sys,json; d=json.load(sys.stdin); print(d.get('status','?'))" 2>/dev/null || echo "?")
        echo -e "  Health    ${GREEN}$status${NC}"
        echo -e "  Model     $model"
    else
        echo -e "  Backend   ${RED}● stopped${NC}  (port $BACKEND_PORT)"
    fi

    # Frontend
    if is_port_open "$FRONTEND_PORT"; then
        echo -e "  Frontend  ${GREEN}● running${NC}  (port $FRONTEND_PORT, PID ${frontend_pid:-active})"
    else
        echo -e "  Frontend  ${RED}● stopped${NC}  (port $FRONTEND_PORT)"
    fi

    # Ollama
    if is_port_open 11434; then
        local models
        models=$(curl -sf "http://localhost:11434/api/tags" 2>/dev/null | \
            python -c "import sys,json; d=json.load(sys.stdin); print(', '.join(m['name'] for m in d.get('models',[])))" 2>/dev/null || echo "?")
        echo -e "  Ollama    ${GREEN}● running${NC}  (port 11434)"
        echo -e "  Models    $models"
    else
        echo -e "  Ollama    ${RED}● stopped${NC}  (port 11434)"
    fi
}

cmd_logs() {
    header "Backend Logs"
    if [[ -f "$BACKEND_LOG" ]]; then
        tail -f "$BACKEND_LOG"
    else
        error "No log file found at $BACKEND_LOG"
        error "Start AIQ first: ./aiq"
    fi
}

cmd_model() {
    header "Model Resolution"
    cd "$ROOT"
    activate_venv 2>/dev/null
    python -c "
from core.config.production_model import (
    get_production_model, get_resolution_info, DEVICE_MAP
)
m = get_production_model()
i = get_resolution_info()
print(f'  Resolved : {m}')
print(f'  Source   : {i[\"source\"]}')
print(f'  Device   : {i[\"device\"]}')
print()
print('  All profiles:')
seen = set()
for device, model in sorted(DEVICE_MAP.items()):
    if model not in seen:
        print(f'    {device:<14} → {model}')
        seen.add(model)
"
}

cmd_install() {
    header "Installing global 'aiq' launcher"
    local bin_dir="$HOME/.local/bin"
    mkdir -p "$bin_dir"
    ln -sf "$ROOT/aiq" "$bin_dir/aiq"
    log "Created symlink: $bin_dir/aiq -> $ROOT/aiq"
    if [[ ":$PATH:" != *":$bin_dir:"* ]]; then
        warn "Note: Ensure $bin_dir is in your PATH."
        warn "Add to ~/.bashrc: export PATH=\"\$HOME/.local/bin:\$PATH\""
    else
        log "You can now type 'aiq' from anywhere in your shell!"
    fi
}

cmd_help() {
    banner
    echo "Usage: ./aiq [command] [port]  (or 'aiq [command] [port]' if installed)"
    echo ""
    echo "Commands:"
    echo "  (none)     Start backend + frontend (auto-allocating free ports)"
    echo "  backend    Start backend only (e.g. ./aiq backend 8105)"
    echo "  frontend   Start frontend only (e.g. ./aiq frontend 5175)"
    echo "  stop       Stop all AIQ processes safely"
    echo "  status     Show running status and verified ports"
    echo "  logs       Tail backend logs"
    echo "  model      Show resolved model configuration"
    echo "  install    Install global 'aiq' binary in ~/.local/bin"
    echo "  help       Show this help"
    echo ""
    echo "Environment:"
    echo "  AION_PORT=8100      Preferred backend port"
    echo "  FRONTEND_PORT=5174  Preferred frontend port"
    echo "  AION_DEVICE=laptop|desktop|server"
    echo "  AION_MODEL=qwen2.5:14b  (manual override)"
    echo ""
    echo "Examples:"
    echo "  ./aiq"
    echo "  ./aiq 8105"
    echo "  ./aiq backend 8102"
    echo "  ./aiq status"
    echo "  ./aiq stop"
}

# ── Entry Point ───────────────────────────────────────────────────────────────

# Check if first argument is a numeric port (e.g. ./aiq 8105)
if [[ "${1:-}" =~ ^[0-9]+$ ]]; then
    PORT_OVERRIDE="$1"
    set -- ""
fi

# Check if second argument is a numeric port for subcommands (e.g. ./aiq backend 8105)
if [[ "${2:-}" =~ ^[0-9]+$ ]]; then
    PORT_OVERRIDE="$2"
fi

case "${1:-}" in
    backend)  activate_venv 2>/dev/null; cd "$ROOT"; cmd_backend; wait ;;
    frontend) activate_venv 2>/dev/null; cd "$ROOT"; cmd_frontend; wait ;;
    stop)     cmd_stop ;;
    status)   cmd_status ;;
    logs)     cmd_logs ;;
    model)    cmd_model ;;
    install)  cmd_install ;;
    help|--help|-h) cmd_help ;;
    "")       cmd_start ;;
    *)        error "Unknown command: $1"; cmd_help; exit 1 ;;
esac
